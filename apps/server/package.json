{
  "name": "@zarghamflow/server",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --pool=threads --maxWorkers=1 --minWorkers=1",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "db:backup": "tsx src/backup.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.1",
    "@vercel/connect": "^2.4.1",
    "@zarghamflow/shared": "*",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.45.4",
    "luxon": "^3.6.1",
    "nodemailer": "^10.0.16",
    "web-push": "^3.6.7",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/luxon": "^3.6.2",
    "@types/node": "^22.15.30",
    "@types/nodemailer": "^8.0.2",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.4",
    "vitest": "^3.2.4"
  }
}
