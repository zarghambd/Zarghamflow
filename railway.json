{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build --workspace @zarghamflow/shared && npm run build --workspace @zarghamflow/server"
  },
  "deploy": {
    "startCommand": "npm run start --workspace @zarghamflow/server",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE"
  }
}
