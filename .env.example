NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/zarghamflow.sqlite
# Optional legacy owner address. If ADMIN_EMAIL is unset and no admins exist, the first verified signup becomes admin.
# OWNER_EMAIL=you@example.com
# Optional designated initial administrator. Public users can still sign up; only this address gets admin role automatically.
ADMIN_EMAIL=admin@example.com
APP_URL=http://localhost:5173
SESSION_SECRET=replace-with-at-least-32-random-characters
LOGIN_SECRET=replace-with-a-different-32-character-secret
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=ZarghamFlow <no-reply@localhost>
# Optional SMTP authentication
# SMTP_USER=
# SMTP_PASS=
# Production Resend SMTP: host is smtp.resend.com, port 465, user resend, pass is your API key.
# RESEND_API_KEY=re_...
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
TRUST_PROXY=false
RATE_LIMIT_MAX=60
