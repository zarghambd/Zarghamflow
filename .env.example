NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/zarghamflow.sqlite
# Set DATABASE_URL for PostgreSQL/Neon deployments; leave unset to use local SQLite.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Optional legacy owner address. If ADMIN_EMAIL is unset and no admins exist, the first verified signup becomes admin.
# OWNER_EMAIL=you@example.com
# Optional designated initial administrator. Public users can still sign up; only this address gets admin role automatically.
ADMIN_EMAIL=admin@example.com
APP_URL=http://127.0.0.1:3001
SESSION_SECRET=replace-with-at-least-32-random-characters
LOGIN_SECRET=replace-with-a-different-32-character-secret
CRON_SECRET=replace-with-a-random-secret-for-scheduled-reminders
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=ZarghamFlow <no-reply@localhost>
# Optional SMTP authentication
# SMTP_USER=
# SMTP_PASS=
# Gmail SMTP: set SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER to your full Google Workspace address, SMTP_PASS to a newly generated Google App Password, and SMTP_FROM to that same address.
# Never use a regular Google account password here.
# Resend API is preferred by the Next.js mailer when RESEND_API_KEY is set.
# RESEND_API_KEY=re_...
# RESEND_FROM=ZarghamFlow <onboarding@resend.dev>
# For production, verify a domain in Resend and use its sender address here.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
TRUST_PROXY=false
RATE_LIMIT_MAX=60
