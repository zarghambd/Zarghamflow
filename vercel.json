{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "server": {
      "root": "apps/server",
      "framework": "fastify",
      "installCommand": "cd ../.. && npm ci",
      "buildCommand": "cd ../.. && npm run build --workspace @zarghamflow/shared && npm run build --workspace @zarghamflow/server"
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "cd ../.. && npm ci",
      "buildCommand": "cd ../.. && npm run build --workspace @zarghamflow/shared && npm run build --workspace @zarghamflow/web",
      "bindings": [
        {
          "type": "service",
          "service": "server",
          "format": "url",
          "env": "FASTIFY_API_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}